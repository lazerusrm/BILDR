{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:harness:eval-sample.v1","type":"object","additionalProperties":false,"required":["schema","sample_id","case_id","case_revision","case_digest","taskset_digest","grader_bundle_digest","policy_digest","base_sha","fixture_digest","setup_digest","runtime_digest","isolation","command_digest","classification","trace_digest","evidence_digest","artifact_digest","cost_receipt_digest","seed","sha256"],"properties":{"schema":{"const":"harness.eval-sample.v1"},"sample_id":{"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,128}$"},"case_id":{"type":"string","pattern":"^[A-Za-z0-9_.:-]{1,128}$"},"case_revision":{"type":"integer","minimum":1},"case_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"taskset_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"grader_bundle_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"policy_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"base_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"fixture_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"setup_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"runtime_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"isolation":{"enum":["available","infrastructure_unavailable"]},"command_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"classification":{"enum":["pass","fail","infrastructure_unavailable","invalidated"]},"trace_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"evidence_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"artifact_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"cost_receipt_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"seed":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
