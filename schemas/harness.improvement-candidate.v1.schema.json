{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:improvement-candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "scope", "parent_bundle", "target_failure", "development_case", "no_change_control", "taskset", "grader_bundle", "runtime", "hypothesis", "edit", "predictions", "evidence", "rollback_bundle", "state", "sha256"],
  "properties": {
    "schema": {"const": "harness.improvement-candidate.v1"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "scope": {"$ref": "#/$defs/scope"},
    "parent_bundle": {"$ref": "#/$defs/policy_bundle"},
    "target_failure": {"$ref": "#/$defs/failure"},
    "development_case": {"$ref": "#/$defs/development"},
    "no_change_control": {"$ref": "#/$defs/development"},
    "taskset": {"$ref": "#/$defs/taskset"},
    "grader_bundle": {"$ref": "#/$defs/grader"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "hypothesis": {"type": "string", "minLength": 1},
    "edit": {"$ref": "#/$defs/edit"},
    "predictions": {"$comment": "CandidateV1::verify enforces unique signal_id; JSON Schema can only enforce whole-object uniqueItems.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["signal_id", "direction", "minimum_delta_milli"], "properties": {"signal_id": {"$ref": "#/$defs/id"}, "direction": {"enum": ["increase", "decrease", "unchanged"]}, "minimum_delta_milli": {"type": "integer"}}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/receipt"}},
    "rollback_bundle": {"$ref": "#/$defs/policy_bundle"},
    "state": {"enum": ["proposed", "rejected", "superseded"]},
    "sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "controller_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["repository_id", "task_family", "model_family", "runtime_class", "base_sha"], "properties": {"repository_id": {"$ref": "#/$defs/controller_id"}, "task_family": {"$ref": "#/$defs/id"}, "model_family": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}, "runtime_class": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}, "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["kind", "revision_id", "digest", "split", "custody"], "properties": {"kind": {"enum": ["trace", "outcome", "failure", "investigation_artifact", "liveness_observation", "reconciliation_episode", "eval_case", "taskset", "grader_bundle", "runtime", "policy_bundle", "human_review"]}, "revision_id": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/digest"}, "split": {"type": ["string", "null"], "enum": ["training", "development", "holdout", "canary", "quarantine", null]}, "custody": {"type": ["string", "null"], "enum": ["clean", "invalidated", "restricted", null]}}},
    "policy_bundle": {"allOf": [{"$ref": "#/$defs/receipt"}, {"properties": {"kind": {"const": "policy_bundle"}}}]},
    "failure": {"allOf": [{"$ref": "#/$defs/receipt"}, {"properties": {"kind": {"const": "failure"}}}]},
    "taskset": {"allOf": [{"$ref": "#/$defs/receipt"}, {"properties": {"kind": {"const": "taskset"}}}]},
    "grader": {"allOf": [{"$ref": "#/$defs/receipt"}, {"properties": {"kind": {"const": "grader_bundle"}}}]},
    "runtime": {"allOf": [{"$ref": "#/$defs/receipt"}, {"properties": {"kind": {"const": "runtime"}}}]},
    "development": {"allOf": [{"$ref": "#/$defs/receipt"}, {"properties": {"kind": {"const": "eval_case"}, "split": {"const": "development"}, "custody": {"const": "clean"}}}]},
    "edit": {"type": "object", "additionalProperties": false, "required": ["dimension", "risk_class", "operation", "before_digest", "after_digest"], "properties": {"dimension": {"enum": ["context_source_ordering", "token_budget", "read_only_probe_parameters", "retry_timing", "cache_summary_policy", "role_prompts", "planning_contracts", "skills", "procedural_memory", "model_effort_routing", "delegation_strategy", "validator_selection", "validator_thresholds", "knowledge_retrieval", "compaction_handoff"]}, "risk_class": {"enum": ["green", "amber"]}, "operation": {"const": "replace"}, "before_digest": {"$ref": "#/$defs/digest"}, "after_digest": {"$ref": "#/$defs/digest"}}, "oneOf": [{"properties": {"dimension": {"enum": ["context_source_ordering", "token_budget", "read_only_probe_parameters", "retry_timing", "cache_summary_policy"]}, "risk_class": {"const": "green"}}}, {"properties": {"dimension": {"enum": ["role_prompts", "planning_contracts", "skills", "procedural_memory", "model_effort_routing", "delegation_strategy", "validator_selection", "validator_thresholds", "knowledge_retrieval", "compaction_handoff"]}, "risk_class": {"const": "amber"}}}]}
  }
}
