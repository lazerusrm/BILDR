{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:policy-bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "repository_id", "task_family", "components", "parent_bundle_id", "safety_anchor_digest", "sha256"],
  "properties": {
    "schema": {"const": "harness.policy-bundle.v1"},
    "bundle_id": {"$ref": "#/$defs/id"},
    "repository_id": {"$ref": "#/$defs/controller_id"},
    "task_family": {"$ref": "#/$defs/id"},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "parent_bundle_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "safety_anchor_digest": {"$ref": "#/$defs/digest"},
    "sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "controller_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "manifest_digest", "risk_class"],
      "properties": {
        "dimension": {"enum": ["context_source_ordering", "token_budget", "read_only_probe_parameters", "retry_timing", "cache_summary_policy", "role_prompts", "planning_contracts", "skills", "procedural_memory", "model_effort_routing", "delegation_strategy", "validator_selection", "validator_thresholds", "knowledge_retrieval", "compaction_handoff"]},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "risk_class": {"enum": ["green", "amber"]}
      },
      "oneOf": [
        {"properties": {"dimension": {"enum": ["context_source_ordering", "token_budget", "read_only_probe_parameters", "retry_timing", "cache_summary_policy"]}, "risk_class": {"const": "green"}}},
        {"properties": {"dimension": {"enum": ["role_prompts", "planning_contracts", "skills", "procedural_memory", "model_effort_routing", "delegation_strategy", "validator_selection", "validator_thresholds", "knowledge_retrieval", "compaction_handoff"]}, "risk_class": {"const": "amber"}}}
      ]
    }
  }
}
