{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:harness.governor-checkpoint.v1",
  "title": "Harness governor durable checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "revision", "status", "operator_update", "milestones",
    "current_milestone_id", "next_action", "blocked_on",
    "durable_artifacts", "workspace_state"
  ],
  "properties": {
    "schema": {"const": "harness.governor-checkpoint.v1"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["progressing", "blocked", "complete"]},
    "operator_update": {"type": "string", "minLength": 1, "maxLength": 6000},
    "milestones": {
      "type": "array",
      "minItems": 3,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/milestone"}
    },
    "current_milestone_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "next_action": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
    "blocked_on": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
    "durable_artifacts": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "workspace_state": {"enum": ["clean", "uncommitted", "controller_committed", "external_only"]}
  },
  "$defs": {
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "outcome", "acceptance"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "status": {"enum": ["pending", "in_progress", "completed", "blocked"]},
        "outcome": {"type": "string", "minLength": 1, "maxLength": 4000},
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "summary", "base_sha", "digest"],
      "properties": {
        "kind": {"enum": ["candidate_tree", "patch", "commit", "pull_request", "report", "external_state"]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 4000},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "base_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "digest": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    }
  }
}
