{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bildr:harness.investigation-artifact.v1",
  "title": "BILDR investigation artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_id", "run_id", "task_id", "attempt_id", "question", "scope", "base_sha", "repository_state_digest", "methods", "sources", "findings", "recommendations", "decision_inventory", "limitations", "rejected_hypotheses", "sensitivity", "artifact_refs", "created_at_ms", "sha256"],
  "properties": {
    "schema": {"const": "harness.investigation-artifact.v1"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "question": {"type": "string", "minLength": 1, "maxLength": 4000},
    "scope": {"$ref": "#/$defs/scope"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_state_digest": {"$ref": "#/$defs/digest"},
    "methods": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "sources": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}},
    "findings": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/finding"}},
    "recommendations": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/recommendation"}},
    "decision_inventory": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/decision"}},
    "limitations": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "rejected_hypotheses": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "sensitivity": {"enum": ["public", "internal", "restricted"]},
    "artifact_refs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["owned_read_paths", "forbidden_paths", "time_budget_ms", "token_budget"], "properties": {"owned_read_paths": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 160}}, "forbidden_paths": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 160}}, "time_budget_ms": {"type": "integer", "minimum": 1}, "token_budget": {"type": "integer", "minimum": 1}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "classification", "summary", "confidence_milli", "evidence_refs", "affected_refs", "risk", "limitations"], "properties": {"finding_id": {"$ref": "#/$defs/id"}, "classification": {"enum": ["confirmed", "supported", "hypothesis", "disproven", "inconclusive"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000}, "evidence_refs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}, "affected_refs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}, "risk": {"enum": ["info", "normal", "high", "critical"]}, "limitations": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}}}},
    "recommendation": {"type": "object", "additionalProperties": false, "required": ["recommendation_id", "summary", "required_authority", "evidence_refs", "alternatives", "risk", "next_verification"], "properties": {"recommendation_id": {"$ref": "#/$defs/id"}, "summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "required_authority": {"$ref": "#/$defs/id"}, "evidence_refs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}, "alternatives": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}}, "risk": {"enum": ["info", "normal", "high", "critical"]}, "next_verification": {"type": "string", "minLength": 1, "maxLength": 4000}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "question", "state", "options", "evidence_refs", "impact", "recommended_option", "required_actor", "blocking_refs", "independent_work_can_continue"], "properties": {"decision_id": {"$ref": "#/$defs/id"}, "question": {"type": "string", "minLength": 1, "maxLength": 4000}, "state": {"$ref": "#/$defs/id"}, "options": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}}, "evidence_refs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}, "impact": {"type": "string", "minLength": 1, "maxLength": 4000}, "recommended_option": {"type": ["string", "null"], "maxLength": 4000}, "required_actor": {"$ref": "#/$defs/id"}, "blocking_refs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}, "independent_work_can_continue": {"type": "boolean"}}}
  }
}
