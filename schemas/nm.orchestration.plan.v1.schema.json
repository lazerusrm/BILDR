{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neuralmatrix:nm.orchestration.plan.v1",
  "title": "NeuralMatrix orchestration run plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "summary", "tasks"],
  "properties": {
    "schema": {"const": "nm.orchestration.plan.v1"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "program_id", "task_id", "title", "state", "priority",
        "execution_mode", "owner_profile", "reviewer_profile", "checklist_rows",
        "authority_refs", "base_sha", "depends_on", "owned_paths", "forbidden_paths",
        "reserved_serial_paths", "objective", "non_goals", "success_criteria",
        "required_positive_tests", "required_negative_tests", "required_metrics",
        "required_evidence", "proof_limits", "diff_budget", "token_budget",
        "lease_expires_at", "stop_conditions", "handoff_path"
      ],
      "properties": {
        "schema": {"const": "nm.orchestration.task.v1"},
        "program_id": {"$ref": "#/$defs/id"},
        "task_id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "state": {"enum": ["proposed", "ready"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "execution_mode": {"enum": ["controller", "agent", "subagent_required", "manual_operator"]},
        "owner_profile": {"$ref": "#/$defs/id"},
        "reviewer_profile": {"$ref": "#/$defs/id"},
        "checklist_rows": {"$ref": "#/$defs/nonEmptyStrings"},
        "authority_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "base_sha": {"$ref": "#/$defs/sha"},
        "dependency_shas": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha"}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "owned_paths": {"$ref": "#/$defs/nonEmptyStrings"},
        "forbidden_paths": {"$ref": "#/$defs/strings"},
        "reserved_serial_paths": {"$ref": "#/$defs/strings"},
        "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
        "non_goals": {"$ref": "#/$defs/strings"},
        "success_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
        "required_positive_tests": {"$ref": "#/$defs/strings"},
        "required_negative_tests": {"$ref": "#/$defs/strings"},
        "required_metrics": {"$ref": "#/$defs/strings"},
        "required_evidence": {"$ref": "#/$defs/nonEmptyStrings"},
        "proof_limits": {"$ref": "#/$defs/nonEmptyStrings"},
        "diff_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "lines"],
          "properties": {
            "files": {"type": "integer", "minimum": 1, "maximum": 500},
            "lines": {"type": "integer", "minimum": 1, "maximum": 100000}
          }
        },
        "token_budget": {"type": "integer", "minimum": 1000, "maximum": 5000000},
        "tool_budget": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000},
        "lease_expires_at": {"type": "string", "minLength": 1},
        "stop_conditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "handoff_path": {"type": "string", "minLength": 1},
        "risk_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": [
            "canonical_contract", "generated_contract", "migration", "tenancy",
            "authentication", "authorization", "privacy", "unsafe_native", "hardware",
            "ota_release", "ci_required_context", "serial_path"
          ]}
        }
      }
    }
  }
}
