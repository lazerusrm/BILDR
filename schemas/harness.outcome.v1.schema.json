{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:outcome.v1",
  "title": "Harness append-only outcome revision payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "outcome_id", "run_id", "subject", "dimension", "classification", "code", "observed_at", "confidence", "source", "supersedes", "reason_code", "correction_artifact_id", "redactor_version", "free_text_redacted"],
  "properties": {
    "schema": {"const": "harness.outcome.v1"},
    "outcome_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "subject": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["run", "task_attempt", "publication"]}, "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"}}},
    "dimension": {"enum": ["operator_acceptance", "operator_correction", "validation", "evidence", "verifier_findings", "completion_state", "resource_use", "ci_required_checks", "review_regression", "pr_reopened", "rollback", "downstream_regression"]},
    "classification": {"enum": ["positive", "negative", "neutral", "unknown"]},
    "code": {"type": "string", "pattern": "^[a-z0-9_]{1,80}$"},
    "observed_at": {"type": "integer", "minimum": 0},
    "confidence": {"enum": ["authoritative", "operator_asserted"]},
    "source": {"type": "object", "additionalProperties": false, "required": ["kind", "record_id", "record_sha256", "source_sha", "source_domain_event_id"], "properties": {"kind": {"enum": ["human_action", "validation", "evidence", "finding", "publication", "domain_event"]}, "record_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"}, "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "source_domain_event_id": {"type": ["integer", "null"], "minimum": 1}}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"}},
    "reason_code": {"type": ["string", "null"], "pattern": "^[a-z0-9_]{1,80}$"},
    "correction_artifact_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "redactor_version": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "free_text_redacted": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"dimension": {"const": "validation"}}}, "then": {"properties": {"classification": {"enum": ["positive", "negative", "unknown"]}, "code": {"enum": ["passed", "failed", "unavailable"]}, "confidence": {"const": "authoritative"}, "source": {"properties": {"kind": {"const": "validation"}}}}, "allOf": [{"if": {"properties": {"classification": {"const": "positive"}}}, "then": {"properties": {"code": {"const": "passed"}}}}, {"if": {"properties": {"classification": {"const": "negative"}}}, "then": {"properties": {"code": {"const": "failed"}}}}, {"if": {"properties": {"classification": {"const": "unknown"}}}, "then": {"properties": {"code": {"const": "unavailable"}}}}]}},
    {"if": {"properties": {"dimension": {"const": "evidence"}}}, "then": {"properties": {"classification": {"enum": ["positive", "negative", "unknown"]}, "code": {"enum": ["proved", "unproved", "unavailable"]}, "confidence": {"const": "authoritative"}, "source": {"properties": {"kind": {"const": "evidence"}}}}, "allOf": [{"if": {"properties": {"classification": {"const": "positive"}}}, "then": {"properties": {"code": {"const": "proved"}}}}, {"if": {"properties": {"classification": {"const": "negative"}}}, "then": {"properties": {"code": {"const": "unproved"}}}}, {"if": {"properties": {"classification": {"const": "unknown"}}}, "then": {"properties": {"code": {"const": "unavailable"}}}}]}},
    {"if": {"properties": {"dimension": {"const": "verifier_findings"}}}, "then": {"properties": {"classification": {"enum": ["positive", "negative", "unknown"]}, "code": {"enum": ["none", "blocking", "nonblocking", "unavailable"]}, "confidence": {"const": "authoritative"}, "source": {"properties": {"kind": {"enum": ["finding", "domain_event"]}}}}, "allOf": [{"if": {"properties": {"classification": {"const": "positive"}}}, "then": {"properties": {"code": {"const": "none"}}}}, {"if": {"properties": {"classification": {"const": "negative"}}}, "then": {"properties": {"code": {"enum": ["blocking", "nonblocking"]}}}}, {"if": {"properties": {"classification": {"const": "unknown"}}}, "then": {"properties": {"code": {"const": "unavailable"}}}}]}},
    {"if": {"properties": {"dimension": {"const": "completion_state"}}}, "then": {"properties": {"classification": {"enum": ["neutral", "unknown"]}, "code": {"enum": ["completed", "blocked", "stopped", "unknown"]}, "confidence": {"const": "authoritative"}, "source": {"properties": {"kind": {"const": "domain_event"}}}}, "allOf": [{"if": {"properties": {"classification": {"const": "neutral"}}}, "then": {"properties": {"code": {"enum": ["completed", "blocked", "stopped"]}}}}, {"if": {"properties": {"classification": {"const": "unknown"}}}, "then": {"properties": {"code": {"const": "unknown"}}}}]}},
    {"if": {"properties": {"dimension": {"const": "resource_use"}}}, "then": {"properties": {"classification": {"enum": ["neutral", "negative", "unknown"]}, "code": {"enum": ["within_budget", "budget_exceeded", "unavailable"]}, "confidence": {"const": "authoritative"}, "source": {"properties": {"kind": {"const": "domain_event"}}}}, "allOf": [{"if": {"properties": {"classification": {"const": "neutral"}}}, "then": {"properties": {"code": {"const": "within_budget"}}}}, {"if": {"properties": {"classification": {"const": "negative"}}}, "then": {"properties": {"code": {"const": "budget_exceeded"}}}}, {"if": {"properties": {"classification": {"const": "unknown"}}}, "then": {"properties": {"code": {"const": "unavailable"}}}}]}},
    {"if": {"properties": {"dimension": {"const": "operator_acceptance"}}}, "then": {"properties": {"confidence": {"const": "operator_asserted"}, "source": {"properties": {"kind": {"const": "human_action"}}}, "classification": {"enum": ["positive", "negative"]}, "code": {"enum": ["accepted_without_correction", "accepted_after_correction", "changes_requested", "abandoned_wrong", "abandoned_cost"]}}, "allOf": [{"if": {"properties": {"classification": {"const": "positive"}}}, "then": {"properties": {"code": {"enum": ["accepted_without_correction", "accepted_after_correction"]}}}}, {"if": {"properties": {"classification": {"const": "negative"}}}, "then": {"properties": {"code": {"enum": ["changes_requested", "abandoned_wrong", "abandoned_cost"]}}}}]}},
    {"if": {"properties": {"dimension": {"const": "operator_correction"}}}, "then": {"properties": {"confidence": {"const": "operator_asserted"}, "source": {"properties": {"kind": {"const": "human_action"}}}, "classification": {"enum": ["neutral", "unknown"]}, "code": {"enum": ["correction_recorded", "correction_not_available"]}}, "allOf": [{"if": {"properties": {"classification": {"const": "neutral"}}}, "then": {"properties": {"code": {"const": "correction_recorded"}}}}, {"if": {"properties": {"classification": {"const": "unknown"}}}, "then": {"properties": {"code": {"const": "correction_not_available"}}}}]}},
    {"if": {"properties": {"dimension": {"const": "ci_required_checks"}}}, "then": {"properties": {"confidence": {"const": "authoritative"}, "source": {"properties": {"kind": {"enum": ["validation", "evidence"]}}}, "classification": {"enum": ["positive", "negative", "unknown"]}, "code": {"enum": ["passed", "failed", "unavailable", "head_mismatch"]}}, "allOf": [{"if": {"properties": {"classification": {"const": "positive"}}}, "then": {"properties": {"code": {"const": "passed"}}}}, {"if": {"properties": {"classification": {"const": "negative"}}}, "then": {"properties": {"code": {"enum": ["failed", "head_mismatch"]}}}}, {"if": {"properties": {"classification": {"const": "unknown"}}}, "then": {"properties": {"code": {"const": "unavailable"}}}}]}},
    {"if": {"properties": {"dimension": {"const": "review_regression"}}}, "then": {"properties": {"confidence": {"const": "operator_asserted"}, "source": {"properties": {"kind": {"const": "human_action"}}}, "classification": {"enum": ["positive", "negative"]}, "code": {"enum": ["review_regression", "review_no_regression"]}}, "allOf": [{"if": {"properties": {"classification": {"const": "negative"}}}, "then": {"properties": {"code": {"const": "review_regression"}}}}, {"if": {"properties": {"classification": {"const": "positive"}}}, "then": {"properties": {"code": {"const": "review_no_regression"}}}}]}},
    {"if": {"properties": {"dimension": {"const": "pr_reopened"}}}, "then": {"properties": {"confidence": {"const": "operator_asserted"}, "source": {"properties": {"kind": {"const": "human_action"}}}, "classification": {"enum": ["positive", "negative"]}, "code": {"enum": ["reopened", "not_reopened"]}}, "allOf": [{"if": {"properties": {"classification": {"const": "negative"}}}, "then": {"properties": {"code": {"const": "reopened"}}}}, {"if": {"properties": {"classification": {"const": "positive"}}}, "then": {"properties": {"code": {"const": "not_reopened"}}}}]}},
    {"if": {"properties": {"dimension": {"const": "rollback"}}}, "then": {"properties": {"confidence": {"const": "operator_asserted"}, "source": {"properties": {"kind": {"const": "human_action"}}}, "classification": {"enum": ["negative", "neutral"]}, "code": {"enum": ["rollback_recorded", "no_rollback"]}}, "allOf": [{"if": {"properties": {"classification": {"const": "negative"}}}, "then": {"properties": {"code": {"const": "rollback_recorded"}}}}, {"if": {"properties": {"classification": {"const": "neutral"}}}, "then": {"properties": {"code": {"const": "no_rollback"}}}}]}},
    {"if": {"properties": {"dimension": {"const": "downstream_regression"}}}, "then": {"properties": {"confidence": {"const": "operator_asserted"}, "source": {"properties": {"kind": {"const": "human_action"}}}, "classification": {"enum": ["positive", "negative"]}, "code": {"enum": ["downstream_regression", "no_downstream_regression"]}}, "allOf": [{"if": {"properties": {"classification": {"const": "negative"}}}, "then": {"properties": {"code": {"const": "downstream_regression"}}}}, {"if": {"properties": {"classification": {"const": "positive"}}}, "then": {"properties": {"code": {"const": "no_downstream_regression"}}}}]}}
  ]
}
