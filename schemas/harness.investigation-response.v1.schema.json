{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bildr:harness.investigation-response.v1",
  "title": "BILDR controller-bound investigation response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "methods", "findings", "recommendations", "decision_inventory", "limitations", "rejected_hypotheses", "sensitivity", "artifact_refs"],
  "anyOf": [
    {"properties": {"findings": {"minItems": 1}}},
    {"properties": {"recommendations": {"minItems": 1}}},
    {"properties": {"decision_inventory": {"minItems": 1}}}
  ],
  "properties": {
    "schema": {"type": "string", "const": "harness.investigation-response.v1"},
    "methods": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "findings": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/finding"}},
    "recommendations": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/recommendation"}},
    "decision_inventory": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/decision"}},
    "limitations": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "rejected_hypotheses": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "sensitivity": {"type": "string", "enum": ["public", "internal", "restricted"]},
    "artifact_refs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "classification", "summary", "confidence_milli", "evidence_refs", "affected_refs", "risk", "limitations"], "properties": {"finding_id": {"$ref": "#/$defs/id"}, "classification": {"type": "string", "enum": ["confirmed", "supported", "hypothesis", "disproven", "inconclusive"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}, "affected_refs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}, "risk": {"type": "string", "enum": ["info", "normal", "high", "critical"]}, "limitations": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}}}},
    "recommendation": {"type": "object", "additionalProperties": false, "required": ["recommendation_id", "summary", "required_authority", "evidence_refs", "alternatives", "risk", "next_verification"], "properties": {"recommendation_id": {"$ref": "#/$defs/id"}, "summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "required_authority": {"$ref": "#/$defs/id"}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}, "alternatives": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}}, "risk": {"type": "string", "enum": ["info", "normal", "high", "critical"]}, "next_verification": {"type": "string", "minLength": 1, "maxLength": 4000}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "question", "state", "options", "evidence_refs", "impact", "recommended_option", "required_actor", "blocking_refs", "independent_work_can_continue"], "properties": {"decision_id": {"$ref": "#/$defs/id"}, "question": {"type": "string", "minLength": 1, "maxLength": 4000}, "state": {"$ref": "#/$defs/id"}, "options": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 4000}}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}, "impact": {"type": "string", "minLength": 1, "maxLength": 4000}, "recommended_option": {"type": ["string", "null"], "maxLength": 4000}, "required_actor": {"$ref": "#/$defs/id"}, "blocking_refs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}}, "independent_work_can_continue": {"type": "boolean"}}}
  }
}
