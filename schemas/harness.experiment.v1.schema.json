{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:experiment.v1",
  "title": "Harness champion challenger experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "candidate_id", "champion_bundle_id", "challenger_bundle_id", "taskset_revisions", "grader_bundle_ids", "runtime_policy_digest", "stages", "statistics", "hard_gate_results", "reward_integrity", "state", "evidence_ids", "sha256"],
  "properties": {
    "schema": {"const": "harness.experiment.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "champion_bundle_id": {"type": "string", "minLength": 1},
    "challenger_bundle_id": {"type": "string", "minLength": 1},
    "taskset_revisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "grader_bundle_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "runtime_policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "state", "sample_count", "successful_pairs"],
        "properties": {
          "kind": {"enum": ["baseline", "development", "holdout", "shadow", "canary"]},
          "state": {"enum": ["pending", "running", "passed", "failed", "inconclusive", "infrastructure_unavailable", "invalidated"]},
          "sample_count": {"type": "integer", "minimum": 0},
          "successful_pairs": {"type": "integer", "minimum": 0},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence_level", "minimum_pairs", "result"],
      "properties": {
        "method": {"enum": ["paired_bootstrap", "paired_permutation", "sequential_test", "exact"]},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "minimum_pairs": {"type": "integer", "minimum": 1},
        "result": {"enum": ["better", "worse", "equivalent", "inconclusive", "pending"]}
      }
    },
    "hard_gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "passed", "evidence"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "reward_integrity": {"enum": ["pending", "pass", "fail", "adjudication_required"]},
    "state": {"enum": ["proposed", "validated", "baselining", "offline_running", "offline_passed", "holdout_running", "holdout_passed", "shadow_running", "shadow_passed", "canary_running", "promotion_review", "promoted", "monitoring", "rolled_back", "retired", "failed", "canceled", "inconclusive", "invalidated"]},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
