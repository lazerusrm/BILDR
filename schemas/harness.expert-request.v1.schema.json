{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bildr:harness.expert-request.v1",
  "title": "BILDR expert request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "run_id", "snapshot_id", "snapshot_revision", "decision_id", "created_at", "expires_at", "signature", "category", "question", "context", "evidence_refs"],
  "properties": {
    "schema": {"const": "harness.expert-request.v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "snapshot_revision": {"type": "integer", "minimum": 1},
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "category": {"type": "string", "enum": ["architecture", "contract", "data", "integration", "repeated_failure", "disagreement", "other"]},
    "question": {"type": "string", "minLength": 1, "maxLength": 4000},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "why_normal_agents_cannot_resolve", "known_facts", "disputed_claims", "constraints", "required_output"],
      "properties": {
        "goal": {"type": "string", "minLength": 1, "maxLength": 8000},
        "why_normal_agents_cannot_resolve": {"type": "string", "minLength": 1, "maxLength": 3000},
        "known_facts": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "disputed_claims": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "constraints": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "required_output": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "summary"],
        "properties": {
          "kind": {"type": "string", "minLength": 1, "maxLength": 128},
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
