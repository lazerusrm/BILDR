{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:trace.v2",
  "title": "Harness deterministic branch-aware trace manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trace_id", "run_id", "task_attempt_id", "source_event_range", "runtime_digest", "redaction_policy_digest", "sensitivity", "nodes", "edges", "branches", "diagnostics", "sha256"],
  "properties": {
    "schema": {"const": "harness.trace.v2"},
    "trace_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "task_attempt_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "source_event_range": {"type": ["object", "null"], "additionalProperties": false, "required": ["first_id", "last_id"], "properties": {"first_id": {"type": "integer", "minimum": 1}, "last_id": {"type": "integer", "minimum": 1}}},
    "runtime_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "redaction_policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "nodes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "content_sha256", "source_receipts", "redaction_class", "timestamp_ms", "metadata"], "properties": {"id": {"type": "string", "pattern": "^n_[0-9a-f]{64}$"}, "kind": {"enum": ["system_message", "developer_message", "user_message", "model_message", "reasoning_summary", "tool_request", "tool_result", "command", "file_read", "file_change", "approval_request", "approval_decision", "compaction", "subagent_spawn", "subagent_join", "validation", "finding", "operator_feedback", "outcome", "unknown_protocol", "run_lifecycle", "attempt_boundary", "runtime_restart"]}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_receipts": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["source", "raw_event_id"], "properties": {"source": {"const": "raw_event"}, "raw_event_id": {"type": "integer", "minimum": 1}}}, {"type": "object", "additionalProperties": false, "required": ["source", "domain_event_id"], "properties": {"source": {"const": "domain_event"}, "domain_event_id": {"type": "integer", "minimum": 1}}}, {"type": "object", "additionalProperties": false, "required": ["source", "receipt_id"], "properties": {"source": {"const": "structural"}, "receipt_id": {"type": "string", "pattern": "^r_[0-9a-f]{64}$"}}}]}}, "redaction_class": {"enum": ["none", "secret_removed", "private_reasoning_removed", "customer_data_removed", "content_withheld"]}, "timestamp_ms": {"type": ["integer", "null"]}, "metadata": {"type": "object", "additionalProperties": false, "properties": {"receipt_count": {"type": "integer", "minimum": 1}}}}}},
    "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "kind"], "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "kind": {"enum": ["next", "context_parent", "tool_result_of", "spawned_by", "joined_into", "compacted_from", "retry_of", "derived_from", "supersedes"]}}}},
    "branches": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "root_node_id", "leaf_node_id", "node_ids", "metadata"], "properties": {"id": {"type": "string", "pattern": "^b_[0-9a-f]{64}$"}, "root_node_id": {"type": "string", "pattern": "^n_[0-9a-f]{64}$"}, "leaf_node_id": {"type": "string", "pattern": "^n_[0-9a-f]{64}$"}, "node_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^n_[0-9a-f]{64}$"}}, "metadata": {"type": "object", "additionalProperties": false, "required": ["path_bound"], "properties": {"path_bound": {"type": "integer", "minimum": 1}}}}}},
    "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "detail", "source_receipts"], "properties": {"code": {"enum": ["ambiguous_mixed_sequence_order", "invalid_source_sequence", "branch_path_bound_reached"]}, "detail": {"enum": ["receipt_order_used", "path_limit_reached"]}, "source_receipts": {"type": "array", "items": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["source", "raw_event_id"], "properties": {"source": {"const": "raw_event"}, "raw_event_id": {"type": "integer", "minimum": 1}}}, {"type": "object", "additionalProperties": false, "required": ["source", "domain_event_id"], "properties": {"source": {"const": "domain_event"}, "domain_event_id": {"type": "integer", "minimum": 1}}}, {"type": "object", "additionalProperties": false, "required": ["source", "receipt_id"], "properties": {"source": {"const": "structural"}, "receipt_id": {"type": "string", "pattern": "^r_[0-9a-f]{64}$"}}}]}}}}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
