{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bildr:harness.external-condition.v1",
  "title": "BILDR external condition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "condition_id", "owner_type", "owner_id", "adapter", "source_id", "spec", "state", "sequence", "poll_policy", "source_identity_digest", "last_observation", "version", "opened_at_ms", "updated_at_ms", "sha256"],
  "properties": {
    "schema": {"const": "harness.external-condition.v1"},
    "condition_id": {"$ref": "#/$defs/id"},
    "owner_type": {"enum": ["run", "task", "attempt"]},
    "owner_id": {"$ref": "#/$defs/id"},
    "adapter": {"enum": ["ci_check", "review_state", "credential_availability", "time_gate", "hardware_capacity", "service_availability"]},
    "source_id": {"$ref": "#/$defs/id"},
    "spec": {"type": "object"},
    "state": {"enum": ["open", "satisfied", "unsatisfied", "unknown", "cancelled"]},
    "sequence": {"type": "integer", "minimum": 0},
    "poll_policy": {"type": "object", "additionalProperties": false, "required": ["initial_ms", "maximum_ms", "deadline_ms"], "properties": {"initial_ms": {"type": "integer", "minimum": 1}, "maximum_ms": {"type": "integer", "minimum": 1}, "deadline_ms": {"type": ["integer", "null"], "minimum": 0}}},
    "source_identity_digest": {"$ref": "#/$defs/digest"},
    "last_observation": {"oneOf": [{"$ref": "#/$defs/observation"}, {"type": "null"}]},
    "version": {"type": "integer", "minimum": 1},
    "opened_at_ms": {"type": "integer", "minimum": 0},
    "updated_at_ms": {"type": "integer", "minimum": 0},
    "sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation": {"type": "object", "additionalProperties": false, "required": ["schema", "observation_id", "condition_id", "source_event_id", "sequence", "observed_at_ms", "state", "payload", "sha256"], "properties": {"schema": {"const": "harness.condition-observation.v1"}, "observation_id": {"$ref": "#/$defs/id"}, "condition_id": {"$ref": "#/$defs/id"}, "source_event_id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1}, "observed_at_ms": {"type": "integer", "minimum": 0}, "state": {"enum": ["open", "satisfied", "unsatisfied", "unknown", "cancelled"]}, "payload": {"type": "object"}, "sha256": {"$ref": "#/$defs/digest"}}}
  }
}
